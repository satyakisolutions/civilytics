{
  "realm": "wastewatch",
  "enabled": true,
  "displayName": "Civilytics WasteWatch (test)",
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read dashboards, acknowledge alerts"
      },
      {
        "name": "admin",
        "description": "Manage cameras, thresholds, and onboard viewers",
        "composite": true,
        "composites": {
          "realm": [
            "viewer"
          ]
        }
      },
      {
        "name": "owner",
        "description": "Full control; onboards admins",
        "composite": true,
        "composites": {
          "realm": [
            "admin"
          ]
        }
      }
    ]
  },
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "wastewatch@satyaki.co.in",
    "fromDisplayName": "Civilytics WasteWatch",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "clients": [
    {
      "clientId": "wastewatch-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "test-client-secret-not-for-production",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": [
        "*"
      ],
      "fullScopeAllowed": true,
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "ww_tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "ww_tenant",
            "claim.name": "ww_tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-wastewatch-api",
      "enabled": true,
      "serviceAccountClientId": "wastewatch-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    },
    {
      "username": "owner",
      "enabled": true,
      "emailVerified": true,
      "email": "owner@test.local",
      "firstName": "Test",
      "lastName": "Owner",
      "credentials": [
        {
          "type": "password",
          "value": "owner-test-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "owner"
      ]
    }
  ],
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60
}

{
  "realm": "wastewatch",
  "enabled": true,
  "displayName": "Civilytics",
  "displayNameHtml": "<b>Civilytics</b>",
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read dashboards, acknowledge alerts"
      },
      {
        "name": "admin",
        "description": "Manage cameras, thresholds, and onboard viewers",
        "composite": true,
        "composites": {
          "realm": [
            "viewer"
          ]
        }
      },
      {
        "name": "owner",
        "description": "Full control; onboards admins",
        "composite": true,
        "composites": {
          "realm": [
            "admin"
          ]
        }
      }
    ]
  },
  "smtpServer": {
    "host": "${WW_SMTP_HOST}",
    "port": "${WW_SMTP_PORT}",
    "from": "${WW_SMTP_FROM}",
    "fromDisplayName": "Civilytics",
    "auth": "true",
    "user": "${WW_SMTP_USER}",
    "password": "${WW_SMTP_PASSWORD}",
    "starttls": "true",
    "ssl": "false"
  },
  "clients": [
    {
      "clientId": "wastewatch-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${WW_KEYCLOAK_CLIENT_SECRET}",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": [
        "*"
      ],
      "fullScopeAllowed": true,
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "ww_tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "ww_tenant",
            "claim.name": "ww_tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "wastewatch-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "wastewatch-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-wastewatch-api",
      "enabled": true,
      "serviceAccountClientId": "wastewatch-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    }
  ],
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60
}
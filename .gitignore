# Environment files — never commit real credentials
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
.uv/

# Node / frontend
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# PyTorch weight caches
*.pth
rf-detr-base.pth
# LFS-tracked model weights (un-ignore)
!backend/models/**/*.pth

# Coverage
.coverage
backend/.coverage

# LSG bring-up: local-only artifacts
sample_videos/*.mp4
sample_videos/*.MP4
local-config/

# LSG bring-up: TRT engines + onnx originals (rebuild via scripts/onnx_to_engine.py)
pipeline/models/**/*.engine
pipeline/models/**/*.orig.onnx
graphify-out/
backend/models/piper/*.onnx
backend/models/piper/*.json
*.onnx.bak
*.engine.bak

# ── Research artefacts (2026-10-06) ────────────────────────────────
# 51 GB of SAM3 masking output, datasets and extracted archives. A job
# writes into research/ while the repo is in use, so this is also a guard
# against committing a half-written dataset.
research/

# Paper PDFs and dataset archives kept locally for reference, not source.
docs/*.pdf
docs/*.zip

# Model weight backups kept beside the live weights.
pipeline/models/**/v1*_backup/
*.bak

# Tooling scratch state
.understand-anything/

# ─────────────────────────────────────────────────────────────────────
# Civilytics / WasteWatch — environment template
#
#   cp .env.example .env    then fill in the REQUIRED values.
#
# NOTE: ./scripts/start.sh dev|test|prod|lite now generates/fills .env
# for you (secrets, ports, per-profile defaults) — see its header. This
# file stays as a reference for every WW_ variable settings.py reads,
# not as the primary way to configure a stack anymore.
#
# Compose declares `env_file: .env` on api, backend-workers and pipeline,
# so the FILE MUST EXIST for any stack to start, even if mostly empty.
# settings.py also reads it directly (env_prefix="WW_", env_file=".env"),
# so these apply to anything run outside Docker too -- tests, scripts, a
# local uvicorn.
#
# Values marked REQUIRED have no usable default. Values marked PROD are
# additionally enforced by docker-compose.prod.yml, which refuses to
# start without them.
# ─────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────
# REQUIRED. settings.py ships database_url = "" deliberately: there are
# no default credentials. Without this you get
#   sqlalchemy.exc.ArgumentError: Could not parse SQLAlchemy URL
WW_DATABASE_URL=postgresql+asyncpg://wastewatch:CHANGE_ME@postgres:5432/wastewatch

# PROD. Also used by Keycloak for its own schema.
POSTGRES_USER=wastewatch
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ────────────────────────────────────────────────────────────
# PROD. Defaults to the literal string "changeme_in_production" in dev.
REDIS_PASSWORD=CHANGE_ME
WW_REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_MAXMEMORY=512mb

# ── Kafka ────────────────────────────────────────────────────────────
WW_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Prod only: bound the log so a stalled consumer cannot fill the disk.
KAFKA_LOG_RETENTION_HOURS=72
KAFKA_LOG_RETENTION_BYTES=5368709120

# ── Authentication (Keycloak) ────────────────────────────────────────
WW_KEYCLOAK_URL=http://keycloak:8080
WW_KEYCLOAK_REALM=wastewatch
WW_KEYCLOAK_CLIENT_ID=wastewatch-api
# REQUIRED for the branded login. The server-side token exchange sends
# client_secret; a CONFIDENTIAL Keycloak client rejects the request
# without it and sign-in fails with 401.
WW_KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# PROD. Keycloak's own admin user.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# PROD. Public hostname Keycloak issues tokens for, e.g. auth.civilytics.in
KC_HOSTNAME=
# Optional prod tunnel. Enter the exact reserved ngrok hostname (no https://).
# start.sh will offer to set KC_HOSTNAME to this value: they must match when
# users sign in through ngrok, otherwise Keycloak redirects to an unreachable
# hostname. ngrok must already be authenticated for the reserved domain.
NGROK_DOMAIN=
# Default true: `start.sh prod` (including `--build`) creates a local-CA
# certificate pair when none exists. Set false to require a pre-installed,
# CA-issued certificate at TLS_CERT_DIR instead.
TLS_AUTO_GENERATE=true

# ⚠ SECURITY — the single most dangerous value in this file.
# 1 returns a mock user holding owner+admin+viewer and bypasses BOTH
# REST and WebSocket authentication. Use only for local bring-up before
# the realm exists. MUST be 0 or absent in test and production.
WW_AUTH_DEV_MODE=0

# Session cookies. Secure=true requires HTTPS, or the browser silently
# drops the cookie and every request arrives anonymous. Set false only
# for local HTTP development.
WW_AUTH_COOKIE_SECURE=true
WW_AUTH_COOKIE_SAMESITE=lax
WW_AUTH_COOKIE_DOMAIN=

# ── Keycloak realm also needs COMPOSITE ROLES ────────────────────────
# Realm roles are flat and require_role() matches the exact string, so
# grant owner -> admin -> viewer as composites or a super admin will be
# denied admin endpoints. Not an env var; noted here because nothing
# else records it.

# ── API / CORS ───────────────────────────────────────────────────────
WW_API_HOST=0.0.0.0
WW_API_PORT=8080
WW_CORS_ORIGINS=http://localhost:5174
API_HOST_PORT=8082

# ── Media ────────────────────────────────────────────────────────────
WW_MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
WW_MEDIAMTX_API_URL=http://mediamtx:9997

# ── Frontend (BUILD-time: Vite inlines these, a restart will not pick
#    up a change -- the image must be rebuilt) ─────────────────────────
FRONTEND_HOST_PORT=5174
# PROD. Browser-reachable URLs, not container names.
PUBLIC_API_URL=
PUBLIC_WS_URL=
PUBLIC_MEDIAMTX_URL=
# Prod keeps MediaMTX's raw HTTP signalling port local and exposes WebRTC
# through nginx's HTTPS /webrtc route. Override only for an intentional
# direct, separately secured MediaMTX endpoint.
MEDIAMTX_WEBRTC_BIND=127.0.0.1

# Optional Coturn relay (`./scripts/start.sh prod --turn`). TURN cannot run
# through an ngrok HTTP tunnel: TURN_HOST needs public DNS pointing directly
# to this server, firewall/NAT forwarding for 3478 TCP+UDP, 5349 TCP, and
# UDP 49160-49500, plus a TLS certificate whose SAN includes TURN_HOST.
TURN_HOST=
TURN_EXTERNAL_IP=
TURN_USER=
TURN_PASSWORD=

# ── Pipeline ─────────────────────────────────────────────────────────
WW_EVIDENCE_DIR=/app/evidence
WW_TTS_DIR=/tmp/wastewatch/tts
# GStreamer verbosity: 1 prod, 2 test, nvinfer:4 when debugging inference.
GST_DEBUG=1

# ── Optional outbound channels (feature flags) ───────────────────────
# All default to false. Enabling one in a non-production environment can
# message real recipients or sound a real speaker.
# Used by the reports worker. Keycloak's onboarding email is configured
# SEPARATELY in Realm settings -> Email; point both at this same relay.
# dev/test override these to the mailpit container (capture-only).
WW_SMTP_ENABLED=false
WW_SMTP_HOST=
WW_SMTP_PORT=587
WW_SMTP_USER=
WW_SMTP_PASSWORD=
WW_SMTP_FROM=wastewatch@satyaki.co.in
WW_SMTP_TLS=true

WW_TELEGRAM_ENABLED=false
WW_TELEGRAM_BOT_TOKEN=
WW_TELEGRAM_CHAT_IDS=

WW_SIP_ENABLED=false
WW_IP_SPEAKER_ENABLED=false
WW_INCIDENT_ENABLED=false

# ── Deterrent audio (TTS) ────────────────────────────────────────────
WW_TTS_ENABLED=false
WW_TTS_VOICE=
WW_TTS_TONE=
WW_TTS_TONE_PREFIX=
WW_TTS_TONE_SUFFIX=
WW_TTS_LENGTH_SCALE=1.0
WW_TTS_SENTENCE_SILENCE=0.2

# ── Evidence archive / backup (S3-compatible) ────────────────────────
WW_BACKUP_ENABLED=false
# Point at MinIO (prod stack) or an external endpoint (AWS, Wasabi, B2).
WW_S3_ENDPOINT=http://minio:9000
WW_S3_BUCKET=wastewatch-evidence
# PROD, when MinIO is used. MinIO requires a password of 8+ characters.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_CONSOLE_PORT=9001

# Legacy Dropbox path. Superseded by the S3 target above; kept because
# backend/app/evidence/dropbox_sync.py still reads it.
WW_DROPBOX_ACCESS_TOKEN=

# ==============================================================================
# WasteWatch Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# ==============================================================================

# Database (Neon Postgres) — REQUIRED
WW_DATABASE_URL=postgresql+asyncpg://user:CHANGE_ME@ep-xxx.us-east-2.aws.neon.tech/wastewatch?sslmode=require

# Kafka
WW_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis (password must match REDIS_PASSWORD below)
WW_REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME

# MediaMTX
WW_MEDIAMTX_API_URL=http://mediamtx:9997
WW_MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554

# API
WW_API_HOST=0.0.0.0
WW_API_PORT=8080
WW_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Auth — REQUIRED for production
# Set to "true" ONLY for local development without Keycloak
WW_AUTH_DEV_MODE=false
WW_KEYCLOAK_URL=http://keycloak:8080
WW_KEYCLOAK_REALM=wastewatch
WW_KEYCLOAK_CLIENT_ID=wastewatch-api
WW_KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# Keycloak admin (Docker Compose) — REQUIRED
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KC_DB_PASSWORD=CHANGE_ME

# VLM (optional — defaults work for Docker Compose)
WW_VLM_BASE_URL=http://vlm:8000/v1
WW_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ

# Alerts (optional)
WW_TELEGRAM_BOT_TOKEN=
WW_TELEGRAM_CHAT_IDS=[]

# Evidence (optional)
WW_DROPBOX_ACCESS_TOKEN=

# Frontend (copy relevant vars to frontend/.env.local)
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=xxx
# VITE_API_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080/ws

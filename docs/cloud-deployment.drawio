<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-04-01" agent="WasteWatch" version="24.0">
  <diagram id="cloud-deployment" name="Cloud Deployment Architecture">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="WasteWatch — Cloud Deployment Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="300" y="-50" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Single-Node GPU (Pilot) → Multi-Node Kubernetes (Production)" style="text;html=1;fontSize=13;align=center;fontColor=#666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="-15" width="900" height="25" as="geometry" />
        </mxCell>

        <!-- ==================== EDGE LAYER ==================== -->
        <mxCell id="edge_layer" value="EDGE — On-Premise (LSG Office / Ward)" style="swimlane;startSize=28;fillColor=#f0f4ff;strokeColor=#4a6fa5;fontStyle=1;fontSize=12;fontColor=#4a6fa5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="450" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cameras" value="&lt;b&gt;IP Cameras&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;RTSP H.264&lt;br&gt;4-50 cameras per site&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce6f5;strokeColor=#4a6fa5;fontSize=11;" vertex="1" parent="edge_layer">
          <mxGeometry x="20" y="40" width="130" height="65" as="geometry" />
        </mxCell>
        <mxCell id="gpu_node" value="&lt;b&gt;GPU Node&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;RTX 3090 / A4000&lt;br&gt;Docker Compose&lt;br&gt;DeepStream + vLLM&lt;br&gt;FastAPI + Kafka + Redis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a2d;fontSize=11;strokeWidth=2;" vertex="1" parent="edge_layer">
          <mxGeometry x="180" y="35" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="local_storage" value="&lt;b&gt;Local SSD&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Evidence buffer&lt;br&gt;500GB+&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="edge_layer">
          <mxGeometry x="20" y="125" width="120" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e_cam_gpu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4a6fa5;strokeWidth=2;" edge="1" source="cameras" target="gpu_node" parent="edge_layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== SECURE TUNNEL ==================== -->
        <mxCell id="tunnel" value="&lt;b&gt;WireGuard / Tailscale VPN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Encrypted tunnel to cloud&lt;br&gt;Metadata + events + evidence sync&lt;br&gt;No raw video over WAN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="70" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e_gpu_tunnel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666;strokeWidth=2;dashed=1;" edge="1" source="gpu_node" target="tunnel" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== CLOUD LAYER ==================== -->
        <mxCell id="cloud_layer" value="CLOUD — AWS / GCP / Azure" style="swimlane;startSize=28;fillColor=#e6f3ff;strokeColor=#0066cc;fontStyle=1;fontSize=12;fontColor=#0066cc;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="750" y="20" width="750" height="550" as="geometry" />
        </mxCell>

        <!-- K8s Cluster -->
        <mxCell id="k8s" value="&lt;b&gt;Kubernetes Cluster&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;EKS / GKE / AKS&lt;/font&gt;" style="swimlane;startSize=25;fillColor=#fff;strokeColor=#326ce5;fontStyle=1;fontSize=11;fontColor=#326ce5;rounded=1;" vertex="1" parent="cloud_layer">
          <mxGeometry x="20" y="40" width="710" height="300" as="geometry" />
        </mxCell>

        <!-- API Pods -->
        <mxCell id="api_pods" value="&lt;b&gt;API Pods (2-4)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;FastAPI + Workers&lt;br&gt;HPA auto-scale&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#cc4444;fontSize=10;" vertex="1" parent="k8s">
          <mxGeometry x="20" y="35" width="130" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ingress" value="&lt;b&gt;Ingress / ALB&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;TLS termination&lt;br&gt;Rate limiting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="k8s">
          <mxGeometry x="20" y="115" width="130" height="55" as="geometry" />
        </mxCell>

        <!-- VLM Pods (GPU) -->
        <mxCell id="vlm_pods" value="&lt;b&gt;VLM Pods (GPU)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;vLLM + Qwen2.5-VL&lt;br&gt;GPU node pool&lt;br&gt;T4 / A10G / L4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6ffe6;strokeColor=#2d6a2d;fontSize=10;strokeWidth=2;" vertex="1" parent="k8s">
          <mxGeometry x="180" y="35" width="140" height="75" as="geometry" />
        </mxCell>

        <!-- Message Queue -->
        <mxCell id="kafka_cloud" value="&lt;b&gt;Managed Kafka&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;MSK / Confluent&lt;br&gt;9 topics&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;size=15;" vertex="1" parent="k8s">
          <mxGeometry x="350" y="35" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Redis -->
        <mxCell id="redis_cloud" value="&lt;b&gt;ElastiCache Redis&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Throttling + cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="k8s">
          <mxGeometry x="520" y="35" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- Worker Pods -->
        <mxCell id="worker_pods" value="&lt;b&gt;Worker Pods&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;TTS, Evidence, LPR&lt;br&gt;Logs, Alert dispatch&lt;br&gt;Horizontal scale&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="k8s">
          <mxGeometry x="180" y="130" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Keycloak -->
        <mxCell id="keycloak_cloud" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Auth pod or managed&lt;br&gt;OAuth2 / OIDC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="k8s">
          <mxGeometry x="350" y="125" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Monitoring -->
        <mxCell id="monitoring_cloud" value="&lt;b&gt;Monitoring Stack&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Prometheus + Grafana&lt;br&gt;Alertmanager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="k8s">
          <mxGeometry x="520" y="115" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- Qdrant -->
        <mxCell id="qdrant_cloud" value="&lt;b&gt;Qdrant Cloud&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Managed vector DB&lt;br&gt;Semantic log search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="k8s">
          <mxGeometry x="520" y="190" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- Helm + ArgoCD -->
        <mxCell id="gitops" value="&lt;b&gt;GitOps&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;ArgoCD + Helm charts&lt;br&gt;GitHub Actions CI/CD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0ff;strokeColor=#4444cc;fontSize=10;" vertex="1" parent="k8s">
          <mxGeometry x="20" y="190" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- HPA -->
        <mxCell id="hpa" value="&lt;b&gt;HPA + KEDA&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Kafka lag-based&lt;br&gt;auto-scaling&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0ff;strokeColor=#4444cc;fontSize=10;" vertex="1" parent="k8s">
          <mxGeometry x="180" y="215" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- Secret management -->
        <mxCell id="secrets" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;AWS SM / Vault&lt;br&gt;DB creds, API tokens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0ff;strokeColor=#4444cc;fontSize=10;" vertex="1" parent="k8s">
          <mxGeometry x="350" y="200" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- ── Managed Services (outside K8s) ── -->

        <!-- Postgres -->
        <mxCell id="postgres_cloud" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Neon Serverless / RDS&lt;br&gt;Auto-scale, backups&lt;br&gt;12 tables, point-in-time recovery&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="cloud_layer">
          <mxGeometry x="20" y="360" width="160" height="120" as="geometry" />
        </mxCell>

        <!-- S3 -->
        <mxCell id="s3" value="&lt;b&gt;S3 / GCS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Evidence storage&lt;br&gt;Lifecycle policies&lt;br&gt;Replaces Dropbox&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="cloud_layer">
          <mxGeometry x="200" y="360" width="150" height="110" as="geometry" />
        </mxCell>

        <!-- CDN -->
        <mxCell id="cdn" value="&lt;b&gt;CloudFront / CDN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Static frontend (React)&lt;br&gt;TLS, edge caching&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=10;strokeWidth=2;" vertex="1" parent="cloud_layer">
          <mxGeometry x="380" y="375" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Notification Services -->
        <mxCell id="notifications" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;SNS / SES / Telegram&lt;br&gt;Push, email, SMS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontSize=10;" vertex="1" parent="cloud_layer">
          <mxGeometry x="570" y="375" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Tunnel → Cloud -->
        <mxCell id="e_tunnel_cloud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0066cc;strokeWidth=2;" edge="1" source="tunnel" target="k8s" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== USERS ==================== -->
        <mxCell id="users_layer" value="USERS" style="swimlane;startSize=25;fillColor=#fafafa;strokeColor=#999;fontStyle=1;fontSize=12;fontColor=#999;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="450" height="300" as="geometry" />
        </mxCell>
        <mxCell id="dashboard" value="&lt;b&gt;Control Room Dashboard&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;React SPA (CDN-served)&lt;br&gt;WebRTC (edge) + WS (cloud)&lt;br&gt;ROI editor, analytics, alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=10;strokeWidth=2;" vertex="1" parent="users_layer">
          <mxGeometry x="20" y="35" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mobile" value="&lt;b&gt;Mobile App (Future)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Field officer alerts&lt;br&gt;Evidence confirmation&lt;br&gt;React Native / Flutter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=10;dashed=1;" vertex="1" parent="users_layer">
          <mxGeometry x="240" y="35" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;Admin Portal&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Keycloak console&lt;br&gt;User/role management&lt;br&gt;Multi-tenant config&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="users_layer">
          <mxGeometry x="20" y="130" width="180" height="65" as="geometry" />
        </mxCell>
        <mxCell id="grafana" value="&lt;b&gt;Grafana Dashboards&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;GPU metrics, Kafka lag&lt;br&gt;API latency, error rates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="users_layer">
          <mxGeometry x="240" y="130" width="180" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ilgms" value="&lt;b&gt;ILGMS Integration (Future)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Kerala LSG portal&lt;br&gt;Complaint auto-creation&lt;br&gt;Fine management&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999;fontSize=10;dashed=1;" vertex="1" parent="users_layer">
          <mxGeometry x="100" y="215" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Users → Cloud -->
        <mxCell id="e_dash_cdn" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3949ab;strokeWidth=2;fontSize=9;fontColor=#888;" edge="1" source="dashboard" target="cdn" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== DEPLOYMENT PHASES ==================== -->
        <mxCell id="phases" value="" style="swimlane;startSize=25;fillColor=#fafafa;strokeColor=#ccc;fontStyle=1;fontSize=11;fontColor=#666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="590" width="1480" height="220" as="geometry" />
        </mxCell>
        <mxCell id="ph_title" value="&lt;b&gt;DEPLOYMENT PHASES&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#333;" vertex="1" parent="phases">
          <mxGeometry x="10" y="3" width="200" height="22" as="geometry" />
        </mxCell>

        <!-- Phase 1: Pilot -->
        <mxCell id="ph1" value="&lt;b&gt;Phase 1: Pilot&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Single GPU node&lt;br&gt;Docker Compose&lt;br&gt;4-10 cameras&lt;br&gt;1 municipality&lt;br&gt;Neon + Dropbox&lt;br&gt;&lt;b&gt;Cost: ~INR 5L/3mo&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a2d;fontSize=10;verticalAlign=top;" vertex="1" parent="phases">
          <mxGeometry x="20" y="35" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ph2" value="&lt;b&gt;Phase 2: District&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;5 GPU nodes&lt;br&gt;Docker + Ansible&lt;br&gt;50 cameras&lt;br&gt;5 municipalities&lt;br&gt;Central Kafka + Postgres&lt;br&gt;&lt;b&gt;Cost: ~INR 32L/yr&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;" vertex="1" parent="phases">
          <mxGeometry x="220" y="35" width="190" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ph3" value="&lt;b&gt;Phase 3: State Cloud&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Kubernetes (EKS/GKE)&lt;br&gt;GPU node pools&lt;br&gt;200+ cameras&lt;br&gt;14 districts&lt;br&gt;ArgoCD + Helm&lt;br&gt;KEDA auto-scale&lt;br&gt;&lt;b&gt;Cost: ~INR 1.5Cr/yr&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=top;" vertex="1" parent="phases">
          <mxGeometry x="430" y="35" width="190" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ph4" value="&lt;b&gt;Phase 4: Multi-Region&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Multi-cluster federation&lt;br&gt;Edge + cloud hybrid&lt;br&gt;1000+ cameras&lt;br&gt;National rollout&lt;br&gt;Data residency compliance&lt;br&gt;DPDP Act alignment&lt;br&gt;&lt;b&gt;Cost: ~INR 5Cr/yr&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;dashed=1;" vertex="1" parent="phases">
          <mxGeometry x="640" y="35" width="200" height="155" as="geometry" />
        </mxCell>

        <!-- Architecture Decisions -->
        <mxCell id="decisions" value="&lt;b&gt;Key Architecture Decisions:&lt;/b&gt;&lt;br&gt;• Video stays on-premise (edge GPU) — only metadata + events go to cloud&lt;br&gt;• Evidence synced async (S3 replaces Dropbox at scale)&lt;br&gt;• Kafka per-site → managed Kafka at district/state level&lt;br&gt;• Frontend served via CDN, API via K8s ingress&lt;br&gt;• GPU inference (DeepStream) always on edge — VLM can run edge or cloud&lt;br&gt;• Keycloak for multi-tenant RBAC (municipality → district → state)&lt;br&gt;• KEDA scales workers based on Kafka consumer lag&lt;br&gt;• WireGuard VPN for secure edge-to-cloud communication" style="text;html=1;fontSize=10;fontColor=#333;align=left;whiteSpace=wrap;spacingLeft=8;verticalAlign=top;" vertex="1" parent="phases">
          <mxGeometry x="870" y="30" width="580" height="165" as="geometry" />
        </mxCell>

        <!-- Phase arrows -->
        <mxCell id="e_ph1_ph2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666;strokeWidth=2;endArrow=block;" edge="1" source="ph1" target="ph2" parent="phases">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ph2_ph3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666;strokeWidth=2;endArrow=block;" edge="1" source="ph2" target="ph3" parent="phases">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ph3_ph4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666;strokeWidth=2;endArrow=block;dashed=1;" edge="1" source="ph3" target="ph4" parent="phases">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

        <!-- Kafka → Workers -->
        <mxCell id="e_kafka_vlm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#e6550d;strokeWidth=1.5;dashed=1;" edge="1" source="kafka" target="vlm_worker" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_kafka_alert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#e6550d;strokeWidth=1.5;dashed=1;" edge="1" source="kafka" target="alert_disp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


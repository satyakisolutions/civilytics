        <!-- Pipeline Branch 1 → MediaMTX (inference output RTSP stream) -->
        <mxCell id="e_pipe_mtx_out" value="&lt;font color=&quot;#e65100&quot;&gt;&lt;b&gt;RTSP OUT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888&quot; style=&quot;font-size:9px&quot;&gt;annotated inference&lt;br&gt;H.264 via RTP/UDP&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#e65100;strokeWidth=3;fontSize=10;" edge="1" source="rtsp_out_branch" target="mediamtx" parent="1">
          <mxGeometry relative="1" as="geometry">

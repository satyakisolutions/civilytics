        <!-- Pipeline Branch 2 → Kafka (metadata path) -->
        <mxCell id="e_pipe_kafka" value="metadata&lt;br&gt;events&lt;br&gt;vlm.requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#e6550d;strokeWidth=2;fontSize=9;fontColor=#888;labelBackgroundColor=#ffffff;" edge="1" source="meta_branch" target="kafka" parent="1">
          <mxGeometry relative="1" as="geometry">

        <mxCell id="monitoring" value="&lt;b&gt;System Monitor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;GPU, storage, containers,&lt;br&gt;models, degradation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="layer_backend">

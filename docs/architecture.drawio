        <mxCell id="kafka_topics" value="&lt;b&gt;Topics:&lt;/b&gt;&lt;br&gt;metadata | events | vlm.requests | vlm.results&lt;br&gt;alerts | lpr | tts | evidence | logs" style="text;html=1;fontSize=10;fontColor=#666;align=center;" vertex="1" parent="1">
          <mxGeometry x="640" y="560" width="320" height="45" as="geometry" />

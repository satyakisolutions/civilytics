        <mxCell id="cam_n" value="&lt;b&gt;Camera N&lt;/b&gt;&lt;br&gt;RTSP H.264" style="shape=image;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0OCIgaGVpZ2h0PSI0OCIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSIjNGE2ZmE1Ij48cGF0aCBkPSJNMTcgMTAuNVY3YzAtLjU1LS40NS0xLTEtMUg0Yy0uNTUgMC0xIC40NS0xIDF2MTBjMCAuNTUuNDUgMSAxIDFoMTJjLjU1IDAgMS0uNDUgMS0xdi0zLjVsNCAzLjV2LTEwbC00IDMuNXoiLz48L3N2Zz4=;imageAlign=center;imageVerticalAlign=top;spacingTop=40;fontSize=11;whiteSpace=wrap;rounded=1;fillColor=#dce6f5;strokeColor=#4a6fa5;dashed=1;" vertex="1" parent="layer_edge">
          <mxGeometry x="105" y="160" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- MediaMTX -->
        <mxCell id="mediamtx" value="&lt;b&gt;MediaMTX&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;RTSP :8554 | WebRTC :8889&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="30" width="180" height="50" as="geometry" />
        </mxCell>
        <!-- MediaMTX role labels -->
        <mxCell id="mtx_input" value="&lt;b&gt;Raw Input Streams&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot; style=&quot;font-size:9px&quot;&gt;Cameras publish RTSP H.264&lt;br&gt;to /cam-01, /cam-02, ...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="30" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mtx_output" value="&lt;b&gt;Inference Output Streams&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot; style=&quot;font-size:9px&quot;&gt;Pipeline publishes annotated&lt;br&gt;H.264 via RTP/UDP back to&lt;br&gt;/cam-01-out, /cam-02-out, ...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="25" width="180" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e_mtx_in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=1;" edge="1" source="mediamtx" target="mtx_input" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mtx_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=1;" edge="1" source="mediamtx" target="mtx_output" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrows: Cameras → MediaMTX -->
        <mxCell id="e_cam_mtx1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4a6fa5;strokeWidth=2;" edge="1" source="cam1" target="mediamtx" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cam_mtx2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4a6fa5;strokeWidth=2;" edge="1" source="cam2" target="mediamtx" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== LAYER: GPU PIPELINE ==================== -->
        <mxCell id="layer_gpu" value="GPU PIPELINE — NVIDIA RTX 3090 (DeepStream 6.x)" style="swimlane;startSize=30;fillColor=#e6ffe6;strokeColor=#2d6a2d;fontStyle=1;fontSize=13;fontColor=#2d6a2d;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="200" width="740" height="220" as="geometry" />
        </mxCell>
        <mxCell id="nvinfer" value="&lt;b&gt;nvinfer&lt;/b&gt;&lt;br&gt;RF-DETR&lt;br&gt;(TensorRT FP16)&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;640x640, batch=4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="layer_gpu">
          <mxGeometry x="20" y="50" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nvtracker" value="&lt;b&gt;nvtracker&lt;/b&gt;&lt;br&gt;ByteTrack&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;MOT, lost_timeout=30s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="layer_gpu">
          <mxGeometry x="200" y="50" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nvanalytics" value="&lt;b&gt;nvdsanalytics&lt;/b&gt;&lt;br&gt;ROI Polygons&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Point-in-polygon test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="layer_gpu">
          <mxGeometry x="380" y="50" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="eventfsm" value="&lt;b&gt;Event FSM&lt;/b&gt;&lt;br&gt;IDLE → ENTER → OBSERVE&lt;br&gt;→ VIOLATION → ALERTING&lt;br&gt;→ ESCALATED / EXITED&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;dwell thresholds: 5s/15s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a2d;fontSize=10;strokeWidth=2;" vertex="1" parent="layer_gpu">
          <mxGeometry x="540" y="40" width="155" height="80" as="geometry" />
        </mxCell>
        <mxCell id="trackstate" value="&lt;b&gt;TrackStateManager&lt;/b&gt;&lt;br&gt;dwell time, bbox history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="layer_gpu">
          <mxGeometry x="200" y="145" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Tee element — splits into 2 branches -->
        <mxCell id="tee_split" value="&lt;b&gt;tee&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a2d;fontSize=11;strokeWidth=2;" vertex="1" parent="layer_gpu">
          <mxGeometry x="575" y="135" width="50" height="50" as="geometry" />
        </mxCell>
        <!-- Branch 1: RTSP output -->
        <mxCell id="rtsp_out_branch" value="&lt;b&gt;Branch 1: RTSP Output&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot; style=&quot;font-size:9px&quot;&gt;nvvideoconvert → H.264 enc&lt;br&gt;→ RTP payload → UDP sink&lt;br&gt;→ MediaMTX (inference stream)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2d6a2d;fontSize=10;strokeWidth=2;" vertex="1" parent="layer_gpu">
          <mxGeometry x="380" y="135" width="170" height="65" as="geometry" />
        </mxCell>
        <!-- Branch 2: Metadata -->
        <mxCell id="meta_branch" value="&lt;b&gt;Branch 2: Metadata&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot; style=&quot;font-size:9px&quot;&gt;fakesink pad probe&lt;br&gt;→ Kafka producer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;strokeWidth=1;" vertex="1" parent="layer_gpu">
          <mxGeometry x="640" y="140" width="90" height="55" as="geometry" />
        </mxCell>
        <!-- FSM → tee -->
        <mxCell id="e_fsm_tee" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2d6a2d;strokeWidth=2;" edge="1" source="eventfsm" target="tee_split" parent="layer_gpu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- tee → Branch 1 (RTSP) -->
        <mxCell id="e_tee_rtsp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2d6a2d;strokeWidth=2;" edge="1" source="tee_split" target="rtsp_out_branch" parent="layer_gpu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- tee → Branch 2 (Metadata/Kafka) -->
        <mxCell id="e_tee_meta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#e65100;strokeWidth=2;" edge="1" source="tee_split" target="meta_branch" parent="layer_gpu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ROI Preprocessor -->
        <mxCell id="roi_preproc" value="&lt;b&gt;ROI Preprocessor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot; style=&quot;font-size:9px&quot;&gt;Poly ROI → bounding rect crop&lt;br&gt;Only rect region sent to nvinfer&lt;br&gt;Saves GPU on full-frame inference&lt;br&gt;&lt;font color=&quot;#1b5e20&quot;&gt;Users edit poly; rect auto-derived&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#1b5e20;fontSize=10;strokeWidth=2;" vertex="1" parent="layer_gpu">
          <mxGeometry x="10" y="130" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- Pipeline arrows -->
        <mxCell id="e_inf_trk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2d6a2d;strokeWidth=2;" edge="1" source="nvinfer" target="nvtracker" parent="layer_gpu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_trk_ana" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2d6a2d;strokeWidth=2;" edge="1" source="nvtracker" target="nvanalytics" parent="layer_gpu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ana_fsm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2d6a2d;strokeWidth=2;" edge="1" source="nvanalytics" target="eventfsm" parent="layer_gpu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MediaMTX → Pipeline (Input: raw RTSP) -->
        <mxCell id="e_mtx_pipe" value="&lt;font color=&quot;#2d6a2d&quot;&gt;RTSP IN&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888&quot; style=&quot;font-size:9px&quot;&gt;raw camera feed&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2d6a2d;strokeWidth=2;fontSize=10;" edge="1" source="mediamtx" target="nvinfer" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== KAFKA ==================== -->
        <mxCell id="kafka" value="&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;:9092&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=0;size=20;" vertex="1" parent="1">

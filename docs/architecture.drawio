        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="WasteWatch — Real-Time Illegal Waste Dumping Detection Platform" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a2e;" vertex="1" parent="1">

        <mxCell id="cam2" value="&lt;b&gt;IP Camera 2&lt;/b&gt;&lt;br&gt;RTSP H.264" style="shape=image;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0OCIgaGVpZ2h0PSI0OCIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSIjNGE2ZmE1Ij48cGF0aCBkPSJNMTcgMTAuNVY3YzAtLjU1LS40NS0xLTEtMUg0Yy0uNTUgMC0xIC40NS0xIDF2MTBjMCAuNTUuNDUgMSAxIDFoMTJjLjU1IDAgMS0uNDUgMS0xdi0zLjVsNCAzLjV2LTEwbC00IDMuNXoiLz48L3N2Zz4=;imageAlign=center;imageVerticalAlign=top;spacingTop=40;fontSize=11;whiteSpace=wrap;rounded=1;fillColor=#dce6f5;strokeColor=#4a6fa5;" vertex="1" parent="layer_edge">

              <mxPoint x="870" y="110" />
              <mxPoint x="510" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== BACKEND SERVICES ==================== -->
        <mxCell id="layer_backend" value="BACKEND — FastAPI + Async Workers" style="swimlane;startSize=30;fillColor=#fff0f0;strokeColor=#cc4444;fontStyle=1;fontSize=13;fontColor=#cc4444;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="460" width="620" height="370" as="geometry" />
        </mxCell>

        <!-- REST API -->
        <mxCell id="restapi" value="&lt;b&gt;REST API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot; style=&quot;font-size:9px&quot;&gt;/cameras /events /alerts /evidence&lt;br&gt;/lpr /analytics /config /system /logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#cc4444;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="20" y="45" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="wsapi" value="&lt;b&gt;WebSocket&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot; style=&quot;font-size:9px&quot;&gt;/ws/metadata/{cam}&lt;br&gt;/ws/events | /ws/alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#cc4444;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="240" y="45" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;Keycloak JWT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;RBAC middleware&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#cc4444;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="420" y="45" width="130" height="65" as="geometry" />
        </mxCell>

        <!-- Workers -->
        <mxCell id="vlm_worker" value="&lt;b&gt;VLM Worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;vlm.requests→results&lt;br&gt;max_concurrent=2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="layer_backend">
          <mxGeometry x="20" y="135" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="alert_disp" value="&lt;b&gt;Alert Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Throttle (Redis)&lt;br&gt;Telegram + WS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="layer_backend">
          <mxGeometry x="180" y="135" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tts_worker" value="&lt;b&gt;TTS Worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Piper TTS + cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="layer_backend">
          <mxGeometry x="330" y="135" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="evidence_worker" value="&lt;b&gt;Evidence Worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;Snapshot + Dropbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="layer_backend">
          <mxGeometry x="20" y="215" width="140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="lpr_worker" value="&lt;b&gt;LPR Worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;PaddleOCR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="layer_backend">

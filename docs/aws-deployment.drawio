        <mxCell id="e_vpn_pipeline" value="RTSP via VPN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=2;dashed=1;fontColor=#2E7D32;fontSize=9;fontStyle=2;" edge="1" source="vpn" target="pipeline" parent="1">
          <mxGeometry relative="1" as="geometry" />

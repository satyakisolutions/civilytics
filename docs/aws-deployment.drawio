        <mxCell id="twilio" value="&lt;b&gt;Twilio / SIP PBX&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888&quot; style=&quot;font-size:9px&quot;&gt;Voice Calls&lt;br&gt;SIP Trunking&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999;fontSize=10;" vertex="1" parent="col5">
          <mxGeometry x="25" y="140" width="170" height="70" as="geometry" />
